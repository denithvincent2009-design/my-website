rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Project cover/gallery images uploaded from the Admin panel.
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Team images are bundled locally in assets/team/ and never uploaded to Firebase.
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
